<table class="table">
    <thead>
    <tr>
        <th></th>
        <th>Etablissement</th>
        <th>Commune</th>
        <th>Animateur</th>
        <th>publié</th>
        <th>actions</th>
    </tr>
    </thead>
    <tbody>
    {% for etablissement in etablissements %}
        <tr>
            <td></td>
            <td>{{ etablissement.name }}</td>
            <td>{{ etablissement.city }}</td>
            <td>{{ etablissement.animateur }}</td>
            <td>
                {% if etablissement.isActive == 0 %}
                    <a class="js-verified" href="{{ path('op_admin_etablissement_verified', {'id': etablissement.id}) }}"><i class="far fa-times-circle text-danger"></i></a>
                {% elseif etablissement.isActive == 1 %}
                    <a class="js-verified" href="{{ path('op_admin_etablissement_verified', {'id': etablissement.id}) }}"><i class="far fa-check-circle text-success"></i></a>
                {% endif %}
            </td>
            <td>
                <a href="{{ path('op_admin_etablissement_show', {'id': etablissement.id}) }}"><i class="far fa-eye"></i></a>&nbsp;
                <a href="{{ path('op_admin_etablissement_edit', {'id': etablissement.id}) }}"><i class="far fa-edit"></i></a>
                {#
                &nbsp;|&nbsp;
            <a href="#" class="js-modalSuppr text-danger" type="button" data-bs-toggle="modal" data-bs-target="#Suppr" data-bs-whatever="{{ etablissement.id }}">
                <i class="fas fa-eraser"></i>
            </a>
                #}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="15">no records found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>