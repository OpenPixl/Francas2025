{% extends 'admin.html.twig' %}

{% block title %}Collégiens-Citoyens{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des établissements',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_etablissement_newetablissement'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer un nouvel établissement',
                'array':null
            },
            'save': {
                'id' : 'btn-header-save',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-floppy-disk"></i>',
                'text' : 'Mettre à jour',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : path('op_admin_etablissement_index'),
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array':null
            }
        }
    }) }}
{% endblock %}

{% block main %}

    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Modifier une page</h2>


        <div class="mt-3">
            {{ include('admin/etablissement/_form.html.twig', {'button_label': 'Mettre à jour', 'hide_submit_button': true}) }}
        </div>


    </section>
