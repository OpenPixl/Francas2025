{% extends 'admin.html.twig' %}

{% block title %}Collégiens-Citoyens{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {% set return_url = path('op_admin_etablissement_index') %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des établissements',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_etablissement_newetablissement'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer un nouvel établissement',
                'array':null
            },
            'save': {
                'id' : 'btn-header-save',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-floppy-disk"></i>',
                'text' : 'Mettre à jour',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : return_url,
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array':null
            },
            'del': {
                'id' : 'btn-header-delete',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-trash"></i>',
                'text' : 'Supprimer',
                'array':null,
                'variant': 'danger',
                'data': {
                    'delete-url': path('op_admin_etablissement_delete', {'id': etablissement.id}),
                    'delete-method': 'DELETE',
                    'csrf-token': csrf_token('delete' ~ etablissement.id),
                    'redirect-url': return_url,
                    'confirm-message': 'Voulez-vous vraiment supprimer cet établissement ? Cette action est irréversible.'
                }
            }
        }
    }) }}
{% endblock %}

{% block main %}

    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Modifier une page</h2>


        <div class="mt-3">
            {{ include('admin/etablissement/_form.html.twig', {'button_label': 'Mettre à jour', 'hide_submit_button': true}) }}
        </div>


    </section>
{% endblock %}



