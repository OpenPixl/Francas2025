{% extends 'base.html.twig' %}

{% block title %}Établissements - {{ typeEtablissement.libelle }}{% endblock %}

{% block main %}
    <section class="mx-auto max-w-7xl px-2 py-4 sm:px-6 lg:px-8" id="etablissement_type_page">
        <h1 class="font-semibold text-2xl text-gray-700 border-b border-b-gray-700 mb-4">{{ typeEtablissement.libelle }}</h1>

        <div class="grid grid-cols-4 gap-4" id="row_etablissement">
            {% for etablissement in etablissements %}
                {% include 'admin/etablissement/include/_card.html.twig' with {
                    etablissement: etablissement,
                    config: config,
                } %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
