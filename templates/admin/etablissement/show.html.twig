{% extends 'admin.html.twig' %}

{% block title %}New Etablissement{% endblock %}

{% block javascripts %}
    {{ parent() }}
{%  endblock %}

{% block header %}
    <section class="container" id="etablissement_page_header">
        <div class="row" id="content">
            {% if etablissement.headerName is null %}
            {% elseif etablissement.logoName is null %}
                <div class="col-12" id="content_header_img">
                    <img id="etablissement_header" class="img-fluid" src="{{ asset('uploads/images/etablissements/'~ etablissement.headerName) }}" alt="{{ etablissement.headerName }}">
                    <div id="etablissement_logo">
                        <img class="img-fluid" src="/uploads/images/fixes/logo-radio-francas" alt="logo_cc">
                    </div>
                    <div id="etablissement_titre">
                        {% if etablissement.id == 29 %}
                            <h3>{{ etablissement.name }}</h3>
                        {% else %}
                            <h3>Établissement {{ etablissement.name }}</h3>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="col-12" id="content_header_img">
                    <img id="etablissement_header" class="img-fluid" src="{{ asset('uploads/images/etablissements/'~ etablissement.headerName) }}" alt="{{ etablissement.headerName }}">
                    <div id="etablissement_logo">
                        <img class="img-fluid" src="{{ asset('uploads/images/etablissements/'~ etablissement.logoName) }}" alt="{{ etablissement.logoName }}">
                    </div>
                    <div id="etablissement_titre">
                        {% if etablissement.id == 29 %}
                            <h3>{{ etablissement.name }}</h3>
                        {% else %}
                            <h3>Établissement {{ etablissement.name }}</h3>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            <div class="col-12" id="etablissement_intro">
                <div id="content_text">
                    {{ etablissement.GroupDescription|raw }}
                </div>
            </div>
        </div>

    </section>
    <section class="container" id="etablissement_page_content">
       {{ render(controller('App\\Controller\\Webapp\\ArticleController::listArticlesByPageEtablissement', {'idetablissement': etablissement.id})) }}
    </section>
{% endblock %}



