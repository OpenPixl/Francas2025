{% for type, etablissements in etablissementsByType %}
    <div class="py-2">
        <h3 class="font-semibold text-lg text-gray-700 border-b border-b-gray-300">{{ type }}</h3>
    </div>
    <div class="grid grid-cols-4 gap-4" id="row_etablissement">
        {% for etablissement in etablissements|slice(0, 8) %}
            {% include 'admin/etablissement/include/_card.html.twig' with {
                etablissement: etablissement,
                config: config,
            } %}
        {% endfor %}
    </div>
    {% if etablissements|length > 8 %}
        <div class="mt-3 text-right">
            <a href="{{ path('op_webapp_etablissement_bytype', {'idtype': etablissements[0].idTypeEtablissement}) }}"
               class="inline-block rounded-md bg-[#d84519] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#c03d16]">
                Voir tous les établissements ({{ etablissements|length }})
            </a>
        </div>
    {% endif %}
{% else %}
    <div class="py-2">
        <h3 class="font-semibold text-lg text-gray-700 border-b border-b-gray-300">Résultats</h3>
        <p>Malheureusement, nous n'avons trouvbé aucun groupes de jeunes avec les informations de recherche transmises.</p>
    </div>
{% endfor %}

