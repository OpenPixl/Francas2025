{% set bannerImage = etablissement.headerName is not null
    ? asset(etablissement_header_url(etablissement)) | imagine_filter('thumb_bandeau_etablissement')
    : asset('/uploads/images/config/' ~ config.headerName)
%}

{% set avatarImage = etablissement.logoName is not null
    ? asset(etablissement_logo_url(etablissement)) | imagine_filter('thumb_logo_etablissement')
    : asset('/uploads/images/config/' ~ config.vignetteName) | imagine_filter('thumb_logo_etablissement')
%}

<section class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-200 dark:bg-gray-950 dark:ring-white/10">
    <div class="relative">
        <img
            src="{{ bannerImage }}"
            alt="Bandeau de présentation de {{ etablissement.name }}"
            class="h-56 w-full object-contain sm:h-64 lg:h-72"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-black/0"></div>

        <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 lg:px-8 lg:pt-8 lg:pb-4">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div class="flex min-w-0 items-end gap-4">
                    <div class="shrink-0 rounded-full bg-white/95 p-1 shadow-lg ring-4 ring-white/30 dark:bg-gray-900/95">
                        <img
                            src="{{ avatarImage }}"
                            alt="Logo de {{ etablissement.name }}"
                            class="size-20 rounded-full object-cover sm:size-24 lg:size-28"
                        />
                    </div>

                    <div class="min-w-0 pb-1">
                        <h1 class="truncate text-2xl font-bold text-white sm:text-3xl">
                            Établissement {{ etablissement.name }}
                        </h1>
                        <p class="text-xs font-medium uppercase tracking-widest text-white/75">
                            {{ etablissement.GroupDescription | striptags('<br>') | raw }}
                        </p>

                    </div>
                </div>

                <div class="hidden flex flex-wrap gap-2 sm:justify-end">
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-200 transition hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/15">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4 text-gray-500 dark:text-gray-300">
                            <path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z" />
                            <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z" />
                        </svg>
                        Message
                    </button>

                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-200 transition hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/15">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4 text-gray-500 dark:text-gray-300">
                            <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" />
                        </svg>
                        Appeler
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
