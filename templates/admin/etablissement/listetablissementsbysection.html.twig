<form method="get" action="" class="my-4 flex flex-wrap items-end gap-3">
    <div class="flex-1 min-w-[200px]">
        <label for="search_q" class="block text-sm font-medium text-gray-700 mb-1">Rechercher un article</label>
        <div class="grid grid-cols-1">
            <input type="search" name="q" id="search_q" placeholder="Titre, contenu..."
                   class="col-start-1 row-start-1 block h-9 w-full rounded-md bg-gray-100 border border-gray-200 pr-3 pl-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-sky-600 sm:text-sm/6" />
            <svg class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
            </svg>
        </div>
    </div>

    <div class="min-w-[200px]">
        <label for="search_type" class="block text-sm font-medium text-gray-700 mb-1">Type d'établissement</label>
        <select name="typeEtablissement" id="search_type"
                class="block h-9 w-full rounded-md bg-gray-100 border border-gray-200 px-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-sky-600 sm:text-sm/6">
            <option value="">Tous les types</option>
            {% for type, etablissements in etablissementsByType %}
                <option value="{{ type }}">{{ type }}</option>
            {% endfor %}
        </select>
    </div>

    <button type="submit" class="h-9 rounded-md bg-[#d84519] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#c03d16]">
        Rechercher
    </button>
</form>

{% for type, etablissements in etablissementsByType %}
    <div class="py-2 mt-4">
        <h3 class="font-semibold text-lg text-gray-700 border-b border-b-gray-300">{{ type }}</h3>
    </div>
    <div class="grid grid-cols-4 gap-4" id="row_etablissement">
        {% for etablissement in etablissements|slice(0, 8) %}
            <a href="{{ path('op_webapp_etablissement_show2', {'id': etablissement.id}) }}" class="group">
                {% if etablissement.logoName %}
                    <img src="{{ asset('/uploads/images/etablissements/'~etablissement.logoName)}}" alt="Logo du groupe de jeunes de {{ etablissement.city }}" class="aspect-square w-full rounded-lg bg-gray-200 object-contain group-hover:opacity-75 xl:aspect-square" />
                {% else %}
                    <img src="{{ asset('/uploads/images/config/' ~ config.vignetteName)}}" alt="Tall slender porcelain bottle with natural clay textured body and cork stopper." class="aspect-square w-full rounded-lg bg-gray-200 object-contain group-hover:opacity-75 xl:aspect-square" />
                {% endif %}
                <h3 class="mt-3 text-sm text-[#d84519]">{{ etablissement.name }}</h3>
                <p class="font-semibold text-gray-900">{{ etablissement.city }}</p>
            </a>
        {% endfor %}
    </div>
    {% if etablissements|length > 8 %}
        <div class="mt-3 text-right">
            <a href="{{ path('op_webapp_etablissement_bytype', {'idtype': etablissements[0].idTypeEtablissement}) }}"
               class="inline-block rounded-md bg-[#d84519] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#c03d16]">
                Voir tous les établissements ({{ etablissements|length }})
            </a>
        </div>
    {% endif %}
{% endfor %}
