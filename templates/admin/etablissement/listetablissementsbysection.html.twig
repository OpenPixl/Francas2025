<div class="grid grid-cols-4 gap-4" id="row_etablissement">
{% for etablissement in etablissements %}
    <a href="{{ path('op_webapp_etablissement_show2', {'id': etablissement.id}) }}" class="group">
        {% if etablissement.logoName %}
            <img src="{{ asset('/uploads/images/etablissements/'~etablissement.logoName)}}" alt="Logo du groupe de jeunes de {{ etablissement.city }}" class="aspect-square w-full rounded-lg bg-gray-200 object-contain group-hover:opacity-75 xl:aspect-square" />
        {% else %}
            <img src="{{ asset('/uploads/images/config/' ~ config.vignetteName)}}" alt="Tall slender porcelain bottle with natural clay textured body and cork stopper." class="aspect-square w-full rounded-lg bg-gray-200 object-contain group-hover:opacity-75 xl:aspect-square" />
        {% endif %}
        <h3 class="mt-3 text-sm text-[#d84519]">{{ etablissement.name }}</h3>
        <p class="font-semibold text-gray-900">{{ etablissement.city }}</p>
    </a>
{% endfor %}
</div>



