<section id="form_search" class="my-4">
    {{ form_start(form, {attr: {'id': 'etablissement_search', 'class': 'flex flex-wrap items-end gap-3'}}) }}
        <div class="flex-1 min-w-[200px]">
            <label for="{{ form.query.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">{{ form.query.vars.label }}</label>
            <div class="grid grid-cols-1">
                <input type="search" name="{{ field_name(form.query) }}" id="{{ form.query.vars.id }}" placeholder="Nom, établissement..." value="{{ field_value(form.query) }}"
                       class="col-start-1 row-start-1 block h-9 w-full rounded-md bg-gray-100 border border-gray-200 pr-3 pl-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-sky-600 sm:text-sm/6" />
                <svg class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
                    <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
                </svg>
            </div>
        </div>

        <div class="min-w-[200px]">
            <label for="{{ form.etablissementChoice.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">{{ form.etablissementChoice.vars.label }}</label>
            <select name="{{ field_name(form.etablissementChoice) }}" id="{{ form.etablissementChoice.vars.id }}"
                    class="block h-9 w-full rounded-md bg-gray-100 border border-gray-200 px-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-sky-600 sm:text-sm/6">
                <option value="">Tous les types</option>
                {% for choice in form.etablissementChoice.vars.choices %}
                    <option value="{{ choice.value }}"{% if field_value(form.etablissementChoice) == choice.value %} selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>

        <button type="submit" class="h-9 rounded-md bg-[#d84519] px-4 text-sm font-semibold text-white shadow-sm hover:bg-[#c03d16]">
            Rechercher
        </button>
    {{ form_end(form) }}
</section>

<section id="form_results" class="mt-4">
    {{ include('admin/etablissement/include/_listesearch.html.twig', {'etablissementsByType': etablissementsByType}) }}
</section>



