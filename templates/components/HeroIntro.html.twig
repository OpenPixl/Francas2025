{#
   Hero d'introduction — titre de page + texte d'intro (HTML CKEditor), en mode
   « HERO » Tailwind aligné à gauche pleine largeur, sans bouton, avec le logo du
   site à droite.

   Utilisé :
   - sur les pages classiques (webapp/page/page.html.twig) quand page.isIntroShow ;
   - sur la page d'accueil (webapp/public/index.html.twig) depuis la page « accueil ».

   Props :
     title     : titre affiché en <h1> (null / '' => pas de titre)
     intro     : contenu HTML de l'intro (rendu tel quel)
     image     : URL de l'image d'illustration de la page (prioritaire sur logo)
     logo      : URL du logo du site, utilisé si `image` est vide
     media_alt : texte alternatif de l'image / du logo (défaut : '')
#}
{% props title = null, intro = null, image = null, logo = null, media_alt = '' %}
{% set media = image ?: logo %}

<section class="mx-auto max-w-7xl px-2 py-10 sm:px-6 lg:px-8 sm:py-14">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0 flex-1">
            {% if title is not empty %}
                <h1 class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white">
                    {{ title }}
                </h1>
                <div class="mt-3 h-px w-24 bg-[#d84519]"></div>
            {% endif %}

            {% if intro is not empty %}
                <div class="mt-6 max-w-3xl text-base/7 text-gray-600 dark:text-gray-300
                            [&_p]:mt-4 [&_p:first-child]:mt-0
                            [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-gray-900 dark:[&_h2]:text-white
                            [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-gray-900 dark:[&_h3]:text-white
                            [&_h4]:mt-4 [&_h4]:text-lg [&_h4]:font-semibold [&_h4]:text-gray-900 dark:[&_h4]:text-white
                            [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1
                            [&_a]:font-medium [&_a]:text-[#d84519] [&_a]:underline [&_a:hover]:no-underline
                            [&_blockquote]:mt-4 [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_blockquote]:italic dark:[&_blockquote]:border-gray-600
                            [&_strong]:font-semibold [&_strong]:text-gray-900 dark:[&_strong]:text-white">
                    {{ intro|raw }}
                </div>
            {% endif %}
        </div>

        {% if media is not empty %}
            <div class="shrink-0">
                <img src="{{ media }}" alt="{{ media_alt }}"
                     class="{{ image is not empty
                         ? 'w-full rounded-lg object-cover sm:w-64 sm:max-h-48 lg:w-80'
                         : 'h-20 w-auto object-contain sm:h-28 lg:h-32' }}">
            </div>
        {% endif %}
    </div>
</section>
