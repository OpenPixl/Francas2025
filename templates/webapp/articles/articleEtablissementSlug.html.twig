{% extends 'base.html.twig' %}

{% block title %}collégiens-Citoyens{% endblock %}

{% block main %}
    {% if article.headerName is null %}
    {% else %}
        <section class="bg-[#ffd100]/20 py-4" id="etablissement_page_header">
            <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
                {% include 'admin/etablissement/include/banner_etablissement.html.twig' %}
            </div>
        </section>
    {% endif %}
    <section class="mx-auto max-w-7xl px-2 py-2 sm:px-6 lg:px-8 mb-6" id="etablissement_page_content">
        {% include 'composants/modules/breadcrumb.html.twig' with {
            'level_1' : {
                'title' : 'Etablissements',
                'href' : path('op_webapp_page', {'slug': 'les-medias-jeunes'})
            },
            'level_2' : {
                'title' : article.slug,
                'href' : '#'
            }
        } %}
        <h1 class="mt-4 font-normal text-2xl text-gray-700 border-b border-gray-700">{{ article.title }}</h1>
        <div class="row" id="content">

            {% if article.imageName is null %}
                <article class="prose max-w-none py-2">
                    {{ article.content|raw }}
                </article>
            {% else %}
                <article class="prose max-w-none py-2">
                    <img
                        src="{{ asset(article.imageUrl) }}"
                        alt="{{ article.imageName }}"
                        class="float-left mr-2 mb-2 w-120 h-auto rounded-lg"
                    >
                    {{ article.content|raw }}
                </article>
            {% endif %}

            <div class="clear-both"></div>

            {% if article.idsupport == 0 %}
            {% elseif article.idsupport == 1 %}
                {{ include('webapp/composants/audio_player_article.html.twig', {
                    'src': asset(article.docUrl),
                    'title': article.title,
                    'artist': article.name,
                }) }}

            {% elseif article.idsupport == 2 %}
                <h4 class="font-normal text-xl text-gray-700 mt-6 mb-3">Visionner la vidéo</h4>
                <div class="shadow shadow-slate-300 m-2" id="content_support">
                    <video controls class="mx-auto block w-3/4">
                        <source src="{{ asset(article.docUrl) }}" type="video/mp4">
                        <p>Votre navigateur ne prend pas en charge les vidéos HTML5.
                            Voici <a href="{{ asset(article.docUrl) }}">un lien pour télécharger la vidéo sur votre ordinateur</a>.</p>
                    </video>
                </div>
            {% elseif article.idsupport == 3 %}
                <div class="col-12" id="content_support">
                    <p>
                        En cliquant sur le lien suivant, vous pourrez télécharger notre document au format "Pdf" au "Doc" : <a href="{{ asset(article.docUrl) }}"><i class="fa-duotone fa-file-pdf fa-2x"></i> Télécharger le fichier</a>
                    </p>

                </div>
            {% else %}
                <div class="col-12" id="content_support">

                </div>
            {% endif %}
        </div>

        {% if is_granted('ROLE_USER') %}
            <div class="hidden">
                {{ render(controller('App\\Controller\\Webapp\\CommentController::new')) }}
            </div>
        {% endif %}
    </section>
{% endblock %}
