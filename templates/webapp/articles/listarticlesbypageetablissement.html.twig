{% if articles is empty %}
    <div id="content" class="mt-3">
        <p>Le groupe de ce collège n'a pas encore produit d'articles.</p>
    </div>
{% else %}
    {% for article in articles %}
    <div id="content" class="row">
        <div class="navigation mt-2">
            {{ knp_pagination_render(articles, 'include/pagination_public.html.twig') }}
        </div>
        {{ include('webapp/articles/include/_blocarticle.html.twig') }}
    </div>
    {% endfor %}
{% endif %}




