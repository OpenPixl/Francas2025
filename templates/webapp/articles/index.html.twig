{% extends 'admin.html.twig' %}

{% block title %}Articles index{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block header %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des articles',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_articles_newadmin'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer un nouvel article',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : path('op_admin_dashboard_index'),
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array':null
            }
        }
    }) }}
{% endblock %}

{% block main %}

    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Liste des articles</h2>
        <p class="text-sm font-light">Créer, Modifier ou supprimer des articles du site</p>

        <div id="liste" class="mt-3">
            {{ include('webapp/articles/include/_liste.html.twig') }}
        </div>

    </section>

{% endblock %}
