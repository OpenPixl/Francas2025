{{ form_start(form) }}
<div>

    {% if form_errors(form) %}
    <div class="flex items-start gap-3 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-red-800 mb-4">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-.75-9.25a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zm.75 6a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"/>
        </svg>
        <div class="text-sm font-medium">{{ form_errors(form) }}</div>
    </div>
    {% endif %}
    <div class="mb-1">
        {% include 'composants/forms/input_text_horizontal.html.twig' with {
            'legend_width' : 'w-3/12',
            'col_width' : 'w-9/12',
            'label' : 'Titre',
            form : form.title,
            'placeholder': 'inscrire le titre',
            'input_width' : 'w-60',
            'oninput': ''
        } %}
    </div>
    <div class="mb-1">
        {% include 'composants/forms/input_text_horizontal.html.twig' with {
            'legend_width' : 'w-3/12',
            'col_width' : 'w-9/12',
            'label' : 'Thème',
            form : form.theme,
            'placeholder': 'inscrire le titre',
            'input_width' : 'w-60',
            'oninput': ''
        } %}
    </div>
    <div class="mb-1">
        {% include 'composants/forms/input_textarea.html.twig' with {
            'legend_width' : 'w-3/12',
            'col_width' : 'w-9/12',
            'label' : 'Contenu de l\'article',
            form : form.content,
            'placeholder': 'Nom ?',
            'input_width' : 'w-full',
            'rows': 10,
            'oninput': ''
        } %}
    </div>

    <div class="mb-1">

        {% include 'composants/forms/blocs/bloc_insert_image.html.twig' with {
            'legend_width' : 'w-3/12',
            'col_width' : 'w-9/12',
            'label' : 'Image',
            'entity_id': article.id,
            'entity_name': article.imageName,
            'url_file': 'uploads/images/colleges/',
            form : form.imageFile,
            suppr_file: form.isSupprImage,
            'input_width' : 'w-full',
            'routename' : 'op_webapp_message_new',
        } %}
    </div>

    <div class="my-2">
        <h3 class="font-semibold text-gray-800 border-b border-b-gray-600 mb-1 uppercase">Support</h3>
        <p class="text-sm text-slate-900 mb-2">Nous vous donnons la possibilité d'ajouter un support (document, vidéo, audio...) à votre article. Pensez à selectionner le bon support sur la liste de choix.</p>
        <div class="mb-1">
            {% include 'composants/forms/input_text_horizontal.html.twig' with {
                'legend_width' : 'w-3/12',
                'col_width' : 'w-9/12',
                'label' : 'Quel type de support ?',
                form : form.support,
                'placeholder': 'inscrire le titre',
                'input_width' : 'w-60',
                'oninput': ''
            } %}
        </div>
        <div class="mb-1">
            {% include 'composants/forms/blocs/bloc_insert_image.html.twig' with {
                'legend_width' : 'w-3/12',
                'col_width' : 'w-9/12',
                'label' : 'Insertion du support',
                'entity_id': article.id,
                'entity_name': article.doc,
                'url_file': 'uploads/images/articles/',
                form : form.docFile,
                suppr_file: form.isSupprDoc,
                'input_width' : 'w-full',
                'routename' : 'op_webapp_message_new',
            } %}
        </div>
    </div>

    <div id="bouton_form">
        {% include 'composants/buttons/button_submit.html.twig' with {
            'id': null,
            'button_width': null,
            'icon': null,
            'text': button_label|default('Enregistrer')
        } %}
    </div>

</div>


{{ form_end(form) }}
