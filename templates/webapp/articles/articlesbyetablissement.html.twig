{% extends 'base.html.twig' %}

{% block title %}Espace Etablissement{% endblock %}

{% block main %}
    <section class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
        <div class="row" id="content">
            {{ include('espace_etablissement/dashboard/_header_etablissement.html.twig') }}
        </div>
    </section>
    <section class="mb-4 mx-auto max-w-7xl px-2 sm:px-6 lg:px-8 border-b border-b-gray-700 text-gray-700 flex justify-between">
        <h5 class="font-semibold text-2xl">Tableau de bord</h5>
        <a href="{{ path('op_admin_security_logout') }}"><i class="fa-duotone fa-solid fa-right-from-bracket"></i> Se déconnecter</a>
    </section>

    <section class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
        <div class="grid grid-cols-4 gap-3">
            <div class="col-span-3">
                <h5>LISTE DES ARTICLES PRODUIT PAR LE GROUPE</h5>
                <p>Tous vos articles publiés sur votre page personelle sont listées ci-dessous.</p>
                <div id="listeArticles">
                    {{ include('webapp/articles/include/_listebyetablissement.html.twig') }}
                </div>
            </div>
            <div>
                {{ render(controller('App\\Controller\\Admin\\EtablissementController::blocAdminEtablissement', {'id':etablissement.id})) }}
            </div>
        </div>
    </section>
{% endblock %}

{% block Modals %}
    {{ parent() }}
{% endblock %}
