{% extends 'admin.html.twig' %}

{% block title %}Edit Articles{% endblock %}


{% block javascripts %}
    {{ parent() }}
{%  endblock %}

{% block header %}
    {% set return_url = path('op_webapp_articles_index') %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des articles',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_articles_newadmin'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer un nouvel article',
                'array':null
            },
            'save': {
                'id' : 'btn-header-save',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-floppy-disk"></i>',
                'text' : 'Mettre à jour',
                'variant': 'primary',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : return_url,
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array': null
            },
            'del': {
                'id' : 'btn-header-delete',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-trash"></i>',
                'text' : 'Supprimer',
                'array':null,
                'variant': 'danger',
                'data': {
                    'delete-url': path('op_webapp_articles_delete', {'id': article.id}),
                    'delete-method': 'DELETE',
                    'csrf-token': csrf_token('delete' ~ article.id),
                    'redirect-url': return_url,
                    'confirm-message': 'Voulez-vous vraiment supprimer cet article ? Cette action est irréversible.'
                }
            }
        }
    }) }}
{% endblock %}

{% block main %}

    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Modifier l'article</h2>


        <div class="mt-3">
            {{ include('webapp/articles/_form2.html.twig', {'button_label': 'Mettre à jour', 'hide_submit_button': true}) }}
        </div>


    </section>


{% endblock %}

