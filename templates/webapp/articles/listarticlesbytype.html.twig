{% extends 'base.html.twig' %}

{% block title %}Articles - {{ typeEtablissement.libelle }}{% if theme %} - {{ theme.name }}{% endif %}{% endblock %}

{% block main %}
    <section class="mx-auto max-w-7xl px-2 py-4 sm:px-6 lg:px-8" id="articles_type_page">
        <h1 class="font-semibold text-2xl text-gray-700 border-b border-b-gray-700 mb-4">
            {{ typeEtablissement.libelle }}{% if theme %} — {{ theme.name }}{% endif %}
        </h1>

        <div class="grid grid-cols-4 gap-4" id="row_articles">
            {% for article in articles %}
                <a href="{{ path('op_webapp_articles_show', {'id': article.id}) }}" class="group relative block aspect-square w-full overflow-hidden rounded-lg bg-gray-200">
                    {% if article.imageName %}
                        <img src="{{ asset(article.imageUrl)}}" alt="image de la publication {{ article.imageName }}" class="absolute inset-0 h-full w-full object-cover transition duration-200 group-hover:opacity-75" />
                    {% else %}
                        <img src="{{ asset('/uploads/images/config/' ~ config.vignetteName)}}" alt="image de la publication" class="absolute inset-0 h-full w-full object-cover transition duration-200 group-hover:opacity-75" />
                    {% endif %}

                    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/60"></div>

                    <div class="absolute inset-x-0 top-0 flex items-center gap-2 p-3">
                        <img src="{{ asset(article.logoUrl) }}" alt="Logo de {{ article.nameEtablissement }}" class="h-6 w-6 flex-shrink-0 rounded-full bg-white object-cover" />
                        <h3 class="text-sm font-semibold text-white drop-shadow-sm">{{ article.nameEtablissement }}</h3>
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center p-3">
                        <p class="text-center text-sm font-semibold text-white drop-shadow-sm">{{ article.title }}</p>
                    </div>

                    {% if article.theme %}
                        <span class="absolute bottom-2 left-2 rounded-full bg-[#ffd100] px-2 py-0.5 text-xs font-medium text-gray-900">
                            {{ article.theme }}
                        </span>
                    {% endif %}
                </a>
            {% else %}
                <p>Aucun article trouvé.</p>
            {% endfor %}
        </div>

        <div class="navigation mt-4">
            {{ knp_pagination_render(articles, 'include/pagination_public.html.twig') }}
        </div>
    </section>
{% endblock %}
