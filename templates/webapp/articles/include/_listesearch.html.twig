{% for type, articles in articlesByType %}
    <div class="py-2">
        <h3 class="font-semibold text-lg text-gray-700 border-b border-b-gray-300">{{ type }}</h3>
    </div>
    <div class="grid grid-cols-4 gap-4" id="row_etablissement">
        {% for article in articles|slice(0, 8) %}
            <a href="{{ path('op_webapp_articles_show', {'id': article.id}) }}" class="group relative block aspect-square w-full overflow-hidden rounded-lg bg-gray-200">
                {% if article.imageName %}
                    <img src="{{ asset(article.imageUrl)}}" alt="image de la publication {{ article.imageName }}" class="absolute inset-0 h-full w-full object-cover transition duration-200 group-hover:opacity-75" />
                {% else %}
                    <img src="{{ asset('/uploads/images/config/' ~ config.vignetteName)}}" alt="image de la publication" class="absolute inset-0 h-full w-full object-cover transition duration-200 group-hover:opacity-75" />
                {% endif %}

                <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/60"></div>

                <div class="absolute inset-x-0 top-0 flex items-center gap-2 p-3">
                    {% if article.logoEtablissement %}
                        <img src="{{ asset(article.logoUrl)}}" alt="Logo de {{ article.nameEtablissement }}" class="h-8 w-8 flex-shrink-0 rounded-full bg-white object-cover" />
                    {% else %}
                        <img src="{{ asset('/uploads/images/config/' ~ config.vignetteName)}}" alt="Logo de {{ article.nameEtablissement }}" class="h-8 w-8 flex-shrink-0 rounded-full bg-white object-cover" />
                    {% endif %}
                    <h3 class="text-sm font-semibold text-white drop-shadow-sm">{{ article.nameEtablissement }}</h3>
                </div>

                <div class="absolute inset-0 flex items-center justify-center p-3">
                    <p class="text-center text-xl font-semibold text-white drop-shadow-sm">{{ article.title }}</p>
                </div>

                {% if article.theme %}
                    <span class="absolute bottom-2 left-2 rounded-full bg-[#ffd100] px-2 py-0.5 text-xs font-medium text-gray-900">
                        {{ article.theme }}
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </div>
    {% if articles|length > 8 %}
        <div class="mt-3 text-right">
            <a href="{{ path('op_webapp_articles_bytype', {
                'idtype': articles[0].idTypeEtablissement,
                'theme': currentTheme|default(null),
                'query': currentQuery|default(null),
            }) }}"
               class="inline-block rounded-md bg-[#d84519] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#c03d16]">
                Voir tous les articles ({{ articles|length }})
            </a>
        </div>
    {% endif %}
{% else %}
    <div class="py-2">
        <h3 class="font-semibold text-lg text-gray-700 border-b border-b-gray-300">Résultats</h3>
        <p>Malheureusement, nous n'avons trouvé aucun groupes de jeunes avec les informations de recherche transmises.</p>
    </div>
{% endfor %}

