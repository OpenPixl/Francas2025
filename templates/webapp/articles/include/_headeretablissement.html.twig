<div class="col-12" id="content_header_img">
    {% if article.headerName is null %}
        <img id="etablissement_header" class="img-fluid" src="{{ asset('/uploads/images/fixes/logo-radio-francas.png') | imagine_filter('thumb_bandeau_etablissement')  }}" alt="logo-radio-francas">
    {% else %}
        <img id="etablissement_header" class="img-fluid" src="{{ vich_uploader_asset(article, 'headerFile', 'App\\Entity\\Admin\\Etablissement' ) | imagine_filter('thumb_bandeau_etablissement') }}" alt="{{ article.headerName }}">
    {% endif %}
    <div id="etablissement_logo">
        <img class="img-fluid" src="{{ vich_uploader_asset(article, 'logoFile', 'App\\Entity\\Admin\\Etablissement' ) | imagine_filter('thumb_logo_etablissement') }}" alt="{{ article.logoName }}">
    </div>
    <div id="etablissement_titre">
        {% if article.etablissementId == 29 %}
            <h3>{{ article.name }}</h3>
        {% else %}
            <h3>Établissement {{ article.name }}</h3>
        {% endif %}
    </div>
</div>