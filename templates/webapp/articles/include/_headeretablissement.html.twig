<div class="col-12" id="content_header_img">
    {% set etablissement = article.etablissement is defined ? article.etablissement : article %}
    {% if article.headerName is null %}
        <img id="etablissement_header" class="img-fluid" src="{{ asset('/uploads/images/fixes/logo-radio-francas.png') | imagine_filter('thumb_bandeau_etablissement')  }}" alt="logo-radio-francas">
    {% else %}
        <img id="etablissement_header" class="img-fluid" src="{{ asset(etablissement_header_url(etablissement)) | imagine_filter('thumb_bandeau_etablissement') }}" alt="{{ article.headerName }}">
    {% endif %}
    <div id="etablissement_logo">
        <img class="img-fluid" src="{{ asset(etablissement_logo_url(etablissement)) | imagine_filter('thumb_logo_etablissement') }}" alt="{{ article.logoName }}">
    </div>
    <div id="etablissement_titre">
        {% if article.etablissementId == 29 %}
            <h3>{{ article.name }}</h3>
        {% else %}
            <h3>Établissement {{ article.name }}</h3>
        {% endif %}
    </div>
</div>