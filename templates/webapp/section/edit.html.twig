{% extends 'admin.html.twig' %}

{% block title %}Edit Section{% endblock %}

{% block header %}
    {% set return_url = path('op_admin_page_show', {'id': page.id }) %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des pages',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_page_new'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer une nouvelle page',
                'array':null
            },
            'save': {
                'id' : 'btn-header-save',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-floppy-disk"></i>',
                'text' : 'Mettre à jour',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : return_url,
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array':null
            },
            'del': {
                'id' : 'btn-header-delete',
                'href' : '#',
                'icon' : '<i class="fa-duotone fa-solid fa-trash"></i>',
                'text' : 'Supprimer',
                'array':null,
                'variant': 'danger',
                'data': {
                    'delete-url': path('op_webapp_section_delete', {'id': section.id}),
                    'delete-method': 'DELETE',
                    'csrf-token': csrf_token('delete' ~ section.id),
                    'redirect-url': return_url,
                    'confirm-message': 'Voulez-vous vraiment supprimer cette section ? Cette action est irréversible.'
                }
            }
        }
    }) }}
{% endblock %}

{% block main %}

    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Modifier la section : "{{ section.name }}" située sur la page "{{ section.page.title }}".</h2>


        <div class="mt-3">
            {{ include('webapp/section/_form.html.twig', {'button_label': 'Mettre à jour', 'hide_submit_button': true}) }}
        </div>


    </section>

{% endblock %}
