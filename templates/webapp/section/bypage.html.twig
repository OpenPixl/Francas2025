{% set countrow = sections|length %}
<div class="d-flex justify-content-between">
    <div>
        <h3 class="font-medium border-b border-b-slate-900 mb-3">Liste des sections de la page</h3>
        <p>Dans cet espace, vous pouvez ajouter/supprimer les différentes sections composants cette dernière.</p>
    </div>
</div>

<div id="op_actions" class="flex justify-end">
    {% include 'composants/buttons/button_utils.html.twig' with {
        'id' : 'btnAddSection',
        'class': '',
        'href' : path('op_webapp_section_add', {'page': page.id}),
        'array' : null,
        'icon': null,
        'text': 'Ajouter une section à la page'
    } %}
</div>
<div id="liste">
    {{ include('webapp/section/include/_liste.html.twig') }}
</div>



