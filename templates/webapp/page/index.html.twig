{% extends 'admin.html.twig' %}

{% block title %}OpenGaia | Administration - site{% endblock %}

{% block header %}
    {{ include('admin/dashboard/include/header.html.twig', {
        'title' : 'Gestions des articles',
        'btns' : {
            'new': {
                'id' : null,
                'href' : path('op_webapp_page_new'),
                'icon' : '<i class="fa-duotone fa-solid fa-square-plus"></i>',
                'text' : 'Créer un nouvel article',
                'array':null
            },
            'return': {
                'id' : null,
                'href' : path('op_admin_dashboard_index'),
                'icon' : '<i class="fa-duotone fa-solid fa-chevrons-left"></i>',
                'text' : 'Retour',
                'array':null
            }
        }
    }) }}
{% endblock %}

{% block main %}
    <section id="op_admin_content_body">

        <h2 class="font-normal uppercase text-xl text-sky-700">Liste des pages du site</h2>
        <p class="text-sm font-light">Créer, Modifier ou supprimer des pages du site.</p>

        <div class="mt-3">
            {% include 'webapp/page/include/_liste.html.twig' %}
        </div>

        <div class="mt-3">
            {# Ajout du template personnalisé pour la pagination en fin du block #}
            {{ knp_pagination_render(pages, 'include/pagination.html.twig') }}
        </div>

    </section>
{% endblock %}
