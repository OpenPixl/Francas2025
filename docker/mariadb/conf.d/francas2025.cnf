# Configuration MariaDB propre au projet Francas2025.
#
# Montée dans le conteneur `db` via docker compose :
#   ./docker/mariadb/conf.d -> /etc/mysql/conf.d (lecture seule)
# L'image mariadb:10.11 charge automatiquement tout /etc/mysql/conf.d/*.cnf.
# Appliquer une modification : `docker compose restart db`.
#
# NB : le fichier ne doit pas être inscriptible par "les autres" (chmod 644),
# sinon MariaDB l'ignore avec un avertissement au démarrage.

[mysqld]
# --- Jeu de caractères : aligné sur l'application (utf8mb4 dans DATABASE_URL) ---
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# --- Réseau ---
# Écoute sur toutes les interfaces du conteneur : nécessaire pour que le port
# publié (3307 hôte -> 3306 conteneur) soit joignable depuis l'IDE.
bind-address = 0.0.0.0
# Les clients Docker se présentent par IP : on évite un reverse-DNS par connexion.
skip-name-resolve = ON

# --- InnoDB : empreinte mémoire maîtrisée (NAS partagé avec Elasticsearch) ---
default-storage-engine  = InnoDB
innodb_buffer_pool_size = 256M
# Optionnel (gain d'I/O au prix d'une durabilité ~1 s en cas de crash brutal) :
# innodb_flush_log_at_trx_commit = 2

# --- Supervision depuis l'IDE ---
# Les requêtes lentes sont écrites dans la table mysql.slow_log (log_output = TABLE),
# interrogeable directement depuis l'IDE, sans fichier ni volume dédié.
log_output            = TABLE
slow_query_log        = ON
long_query_time       = 1
log_queries_not_using_indexes = OFF

[mariadb]
# Section lue uniquement par MariaDB (ignorée par les outils MySQL).
